# ── Telegram ──────────────────────────────────────────────────
# Get from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your personal Telegram chat ID (send /start to @userinfobot to get it)
TELEGRAM_CHAT_ID=your_chat_id_here

# ── Dry Run (Paper Trading) ───────────────────────────────────
# Set DRY_RUN=true to run without a wallet.
# Uses live mainnet price data but ALL trades are simulated.
# No private key or wallet address needed in this mode.
DRY_RUN=true
PAPER_BALANCE=10000.0

# ── Hyperliquid ───────────────────────────────────────────────
# Only required when DRY_RUN=false
# Your wallet private key (starts with 0x)
HL_PRIVATE_KEY=0xyour_private_key_here

# Your wallet address (public, starts with 0x)
HL_WALLET_ADDRESS=0xyour_wallet_address_here

# Use testnet first! Set to false when ready for mainnet
HL_TESTNET=true

# ── Strategy ─────────────────────────────────────────────────
# Comma-separated trading pairs
PAIRS=BTC,ETH,SOL,AVAX,LINK,DOGE

# Candle timeframe: 5m recommended (outperforms 15m consistently in backtests)
TIMEFRAME=5m

# Position size as fraction of account (0.10 = 10%)
POSITION_SIZE_PCT=0.10

# Minimum risk-to-reward ratio (default 2.5)
MIN_RR=2.5

# Pivot lookback (candles on each side to confirm a swing high/low)
PIVOT_LOOKBACK=5

# ── Zone detection ────────────────────────────────────────────
# Min body-to-range ratio for an impulse candle (0.6 = 60%)
IMPULSE_BODY_RATIO=0.6

# Impulse body must be X times larger than average recent body
IMPULSE_SIZE_MULTIPLIER=1.5

# Stop loss buffer below/above zone (0.001 = 0.1%)
SL_BUFFER=0.001
